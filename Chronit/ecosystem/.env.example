# =============================================================================
# CHRONIT ECOSYSTEM — Variables de entorno (copiar a .env y ajustar)
# =============================================================================

# --- Servicio de carrera (Chronit Core) ---
# Puerto serie del decodificador ESL-400
SERIAL_PORT=/dev/ttyUSB0
# IP del host (para acceder al servidor desde dispositivos de la LAN)
HOST_IP=192.168.1.10

# --- PostgreSQL ---
POSTGRES_USER=chronit
POSTGRES_PASSWORD=chronit_secret
POSTGRES_DB=chronit
# Puerto del host para acceder a PostgreSQL (5433 para no chocar con uno local)
POSTGRES_PORT=5433

# --- Valkey (sesiones + caché) ---
# Puerto del host para acceder a Valkey
VALKEY_PORT=6380

# --- Backend de Tickets ---
# Secreto JWT para sesiones de usuario (cambiar en producción)
JWT_SECRET=change_me_in_env
# CORS: orígenes permitidos separados por coma (mostrar la URL real del front).
#   Vacío (default) = refleja el origen del navegador (solo desarrollo).
#   Ej. producción: http://kiosco.midominio.com,http://web.midominio.com
CORS_ORIGINS=
# Seed de usuarios por defecto en cada arranque (true = ejecuta el seed)
SEED_ENABLED=true
# Coste del hash bcrypt de los seeds (default 10)
BCRYPT_ROUNDS=10
# Opcional: override de los usuarios a sembrar (JSON). Si se omite, se siembran
#   los 3 de prueba (ADMIN-001, CAJERO-001, COORD-001).
#   Ej. SEED_USERS_JSON='[{"carnet":"X","password":"Y","rol":"admin","nombre":"Z"}]'
SEED_USERS_JSON=

# --- Frontend Web ---
# URL pública de la API de tickets (para el navegador).
#   Local            -> http://localhost:4000
#   Producción       -> http://api.midominio.com
#   OTRA MÁQUINA     -> http://IP_MAQUINA_BACKEND:4000
# AVISO (IMPORTANTE): NEXT_PUBLIC_* se inyecta EN TIEMPO DE BUILD de Next.js.
#   Si cambias esta URL, debes reconstruir la imagen del frontend. No cambiará
#   al levantar el contenedor con solo variables de entorno en runtime.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Modo por defecto de la app: 'public' (pantalla) / 'kiosco' / 'admin'
NEXT_PUBLIC_DISPLAY_MODE=public

# --- Sentinela de sincronización ---
# Intervalo de sincronización en segundos
SYNC_INTERVAL=30

# --- Imágenes (modo offline/online) ---
# Servidor local de imágenes (nginx, modo offline)
#   Docker: http://images:80 | Host/navegador: http://localhost:5001
LOCAL_IMAGE_URL=http://images:80
PUBLIC_IMAGE_URL=https://tudominio.com
# URL que usan los navegadores (Next.js solo expone variables NEXT_PUBLIC_*)
NEXT_PUBLIC_LOCAL_IMAGE_URL=http://localhost:5001
NEXT_PUBLIC_PUBLIC_IMAGE_URL=https://tudominio.com

# --- Borde TLS (cifrado en tránsito) ---
# COMPOSE_FILE activa el borde TLS por defecto: el ecosistema se sirve por HTTPS
# a través del contenedor `edge` y los servicios dejan de publicar HTTP directo.
# Comenta esta línea para trabajar en modo HTTP de desarrollo.
COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
# Certificado autofirmado (solo si NO hay un certificado propio en
# services/edge/certs/server.crt + server.key).
TLS_CN=localhost
TLS_IP=127.0.0.1
# SANs adicionales separados por coma, ej. DNS:kiosco.midominio.com,DNS:web.midominio.com
TLS_EXTRA_SAN=
# Fuerza el flag Secure en la cookie de sesión (se activa solo en el perfil TLS;
# con HTTPS real déjalo en true).
COOKIE_SECURE=true
